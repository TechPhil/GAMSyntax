/* A small expression grammar in W3C-style EBNF */
expression ::= term (('+' | '-') term)*
term       ::= factor (('*' | '/') factor)*
factor     ::= NUMBER | IDENT call? | '(' expression ')' | '-' factor
call       ::= '(' (expression (',' expression)*)? ')'
NUMBER     ::= [0-9]+ ('.' [0-9]+)? (('e' | 'E') ('+' | '-')? [0-9]+)?
IDENT      ::= [a-zA-Z_] [a-zA-Z0-9_]*
